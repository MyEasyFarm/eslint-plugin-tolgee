{
  "name": "@myeasyfarm/eslint-plugin-tolgee",
  "version": "0.1.0",
  "description": "ESLint rules for Tolgee i18n — enforce translation keys and string-argument t() calls.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "tolgee",
    "i18n",
    "internationalization",
    "translation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyEasyFarm/eslint-plugin-tolgee.git"
  },
  "bugs": {
    "url": "https://github.com/MyEasyFarm/eslint-plugin-tolgee/issues"
  },
  "homepage": "https://github.com/MyEasyFarm/eslint-plugin-tolgee#readme",
  "peerDependencies": {
    "eslint": ">=9 <10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.18.1",
    "@typescript-eslint/utils": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-plugin-eslint-plugin": "^6.4.0",
    "eslint-vitest-rule-tester": "^2.2.1",
    "tsdown": "^0.12.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  }
}
